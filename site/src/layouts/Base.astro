---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description?: string;
  /** Rubrique de la navigation à marquer comme active. */
  section?: 'reponses' | 'chapitres' | 'debats' | null;
}
const {
  title,
  description = 'Mille milliards : les finances publiques françaises, chiffrées, comparées et sourcées.',
  section = null,
} = Astro.props;

const path = Astro.url.pathname;
const NAV = [
  { key: 'reponses', href: '/reponses/', label: 'Réponses' },
  { key: 'chapitres', href: '/chapitres/', label: 'Chapitres' },
  { key: 'debats', href: '/debats/', label: 'Débats' },
] as const;
// aria-current="page" sur la page elle-même, "true" dans la rubrique.
const current = (n: (typeof NAV)[number]) => (path === n.href ? 'page' : section === n.key ? 'true' : undefined);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap" />
    <script is:inline>
      // Thème choisi par le lecteur (avant le premier rendu, pour éviter un éclair de l'autre thème).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Mille milliards, accueil"><LogoMark size={24} /><span>Mille milliards</span></a>
        <nav class="main" aria-label="Navigation principale">
          <ul>
            {NAV.map((n) => <li><a href={n.href} aria-current={current(n)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <button class="toggle" id="theme-toggle" type="button" hidden aria-label="Changer de thème">
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg>
          <span class="toggle-label" aria-hidden="true">Thème</span>
        </button>
      </div>
    </header>

    <main id="contenu" tabindex="-1" class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="row">
          <div class="sig">
            <a class="brand mono" href="/" aria-label="Mille milliards, accueil"><LogoMark size={24} /><span>Mille milliards</span></a>
            <p class="tagline"><i>Mille milliards de mille sabords !</i></p>
          </div>
          <nav aria-label="Pied de page">
            <ul>
              {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
        </div>
        <p class="licence">Textes et données sous licence CC BY 4.0</p>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
