---
import Base from '../../layouts/Base.astro';
import AnswerCard from '../../components/AnswerCard.astro';
import { sortedAnswers, ORDER_RULE, deficit } from '../../lib/site.mjs';
const answers = sortedAnswers();
---
<Base title="Réponses · Mille milliards" description="Ce que l’on entend sur les finances publiques, chiffré : combien, et quelle part du déficit." section="reponses">
  <header class="page-head">
    <p class="eyebrow">Oui, mais…</p>
    <h1>Ce que l’on entend, chiffré</h1>
    <p class="lede">Pour chaque phrase : ce qui est vrai, combien cela représente chaque année, et où sont les limites. La barre montre la part du déficit public de {deficit.year} ({deficit.text}).</p>
  </header>
  <section class="blk" aria-labelledby="liste-titre">
    <h2 id="liste-titre" class="visually-hidden">Toutes les réponses</h2>
    {answers.length ? (
      <ul class="cards">
        {answers.map((a) => <li><AnswerCard answer={a} /></li>)}
      </ul>
    ) : (
      <p>Aucune page de réponse publiée pour l’instant.</p>
    )}
    <p class="order-note">{ORDER_RULE}</p>
  </section>
</Base>
