{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/figures.schema.json",
  "title": "Canonical figures",
  "type": "object",
  "required": [
    "meta",
    "figures",
    "superseded"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "dataset",
        "schema",
        "as_of",
        "version",
        "description",
        "conventions"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "conventions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "superseded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_id",
          "superseded_value",
          "label_en"
        ],
        "additionalProperties": false,
        "properties": {
          "figure_id": {
            "type": "string"
          },
          "superseded_value": {
            "type": "number"
          },
          "label_en": {
            "type": "string"
          }
        }
      }
    },
    "rating_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rating_action"
      }
    },
    "rating_tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rating_table"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_en",
        "label_fr",
        "value",
        "unit",
        "base",
        "year",
        "vintage",
        "source",
        "source_id",
        "url",
        "range",
        "rank_of",
        "notes",
        "status",
        "origin",
        "file00_row",
        "source_file",
        "match_text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label_en": {
          "type": "string",
          "minLength": 3
        },
        "label_fr": {
          "type": "string",
          "minLength": 3
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "base": {
          "enum": [
            "pct_gdp",
            "pct_total_spending",
            "pct_gni",
            "pp_gdp",
            "pct_of_gap",
            "pct_of_stock",
            "pct_yield",
            "pct_population",
            "pct",
            "eur_bn",
            "eur_per_capita",
            "pps_per_capita",
            "rank",
            "ratio",
            "bp",
            "years",
            "score",
            "year",
            "persons",
            "persons_m",
            "count",
            "hours",
            "notches",
            "pct_change"
          ]
        },
        "year": {
          "type": "string"
        },
        "vintage": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "pattern": "^f\\d{2}(:[A-Za-z0-9_^-]+)?$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "rank_of": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "caveat"
          ]
        },
        "origin": {
          "enum": [
            "file00",
            "topic_file"
          ]
        },
        "file00_row": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_file": {
          "type": "string",
          "pattern": "^\\d{2}-[a-z0-9-]+\\.md$"
        },
        "match_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rating_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agency",
        "date",
        "action",
        "rating_before",
        "rating_after",
        "outlook_before",
        "outlook_after",
        "source",
        "url",
        "research_file",
        "match_text",
        "status",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "agency": {
          "enum": [
            "Moody's",
            "S&P",
            "Fitch",
            "DBRS Morningstar",
            "Scope",
            "KBRA",
            "R&I",
            "JCR"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "action": {
          "enum": [
            "downgrade",
            "upgrade",
            "outlook_change",
            "affirmation",
            "review_listed_by_aft"
          ]
        },
        "rating_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "outlook_before": {
          "enum": [
            "positive",
            "stable",
            "negative",
            null
          ]
        },
        "outlook_after": {
          "enum": [
            "positive",
            "stable",
            "negative",
            null
          ]
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "research_file": {
          "type": "string",
          "pattern": "^\\d{2}-[a-z0-9-]+\\.md$"
        },
        "match_text": {
          "type": "string",
          "minLength": 5
        },
        "status": {
          "enum": [
            "verified",
            "caveat"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rating_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_en",
        "label_fr",
        "figure_ids",
        "action_ids",
        "not_included",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label_en": {
          "type": "string"
        },
        "label_fr": {
          "type": "string"
        },
        "figure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_included": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
