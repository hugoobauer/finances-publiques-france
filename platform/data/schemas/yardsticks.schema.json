{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/yardsticks.schema.json",
  "title": "Yardsticks",
  "type": "object",
  "required": [
    "meta",
    "parameters",
    "conversions",
    "yardsticks"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "dataset",
        "schema",
        "as_of",
        "version",
        "description",
        "conventions"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "conventions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      }
    },
    "conversions": {
      "$ref": "#/$defs/conv"
    },
    "yardsticks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/yardstick"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "param": {
      "type": "object",
      "required": [
        "id",
        "value",
        "label_en",
        "label_fr"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "value": {
          "type": "number"
        },
        "label_en": {
          "type": "string"
        },
        "label_fr": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conv": {
      "type": "object",
      "required": [
        "one_day_spending_eur_bn",
        "deficit_eur_bn",
        "population_m",
        "te_eur_bn",
        "gdp_eur_bn"
      ],
      "properties": {
        "one_day_spending_eur_bn": {
          "type": "string"
        },
        "deficit_eur_bn": {
          "type": "string"
        },
        "population_m": {
          "type": "string"
        },
        "te_eur_bn": {
          "type": "string"
        },
        "gdp_eur_bn": {
          "type": "string"
        },
        "formulas_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "yardstick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_en",
        "label_fr",
        "formula",
        "value",
        "unit",
        "published_in_file20",
        "figure_ids",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label_en": {
          "type": "string"
        },
        "label_fr": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "value_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "unit": {
          "type": "string"
        },
        "display_decimals": {
          "type": [
            "integer",
            "null"
          ]
        },
        "store_decimals": {
          "type": "integer"
        },
        "published_in_file20": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "text",
                "section"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "section": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "figure_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "checks_figure_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_from_day_of_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
