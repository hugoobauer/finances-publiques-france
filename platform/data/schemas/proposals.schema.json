{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/proposals.schema.json",
  "title": "Costed proposals",
  "type": "object",
  "required": [
    "meta",
    "sign_convention",
    "proposers",
    "proposals"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "dataset",
        "schema",
        "as_of",
        "version",
        "description",
        "conventions"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "conventions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sign_convention": {
      "type": "string"
    },
    "proposers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposer"
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pband": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "low",
            "central",
            "high"
          ],
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "central": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "year": {
              "type": [
                "string",
                "null"
              ]
            },
            "text_en": {
              "type": [
                "string",
                "null"
              ]
            },
            "label_en": {
              "type": [
                "string",
                "null"
              ]
            },
            "central_is_midpoint": {
              "type": "boolean"
            },
            "computed_by_us": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "required": [
        "author",
        "orientation",
        "low",
        "central",
        "high",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        },
        "low": {
          "type": [
            "number",
            "null"
          ]
        },
        "central": {
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^f\\d{2}(:[A-Za-z0-9_^-]+)?$"
          }
        },
        "computed_by_us": {
          "type": "boolean"
        }
      }
    },
    "metric_band": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "number"
        },
        "central": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "derived_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days_of_spending": {
          "$ref": "#/$defs/metric_band"
        },
        "pct_of_deficit": {
          "$ref": "#/$defs/metric_band"
        },
        "eur_per_inhabitant": {
          "$ref": "#/$defs/metric_band"
        },
        "pct_of_total_spending": {
          "$ref": "#/$defs/metric_band"
        },
        "pct_of_gdp": {
          "$ref": "#/$defs/metric_band"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "measure_en",
        "measure_fr",
        "kind",
        "parties",
        "horizon",
        "claimed",
        "estimates",
        "range",
        "status",
        "confidence",
        "legal_flag",
        "counter_argument_en",
        "caveats_en",
        "source_ids",
        "research_files",
        "derived",
        "claimed_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "measure_en": {
          "type": "string"
        },
        "measure_fr": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "party_proposal",
            "program_total",
            "government_measure",
            "past_measure",
            "think_tank_proposal",
            "option",
            "benchmark"
          ]
        },
        "parties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "horizon": {
          "type": "string"
        },
        "claimed": {
          "$ref": "#/$defs/pband"
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimate"
          }
        },
        "range": {
          "$ref": "#/$defs/pband"
        },
        "status": {
          "enum": [
            "independently_costed",
            "claim_only",
            "own_computation",
            "observed",
            "not_costed"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "legal_flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "counter_argument_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "caveats_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^f\\d{2}(:[A-Za-z0-9_^-]+)?$"
          }
        },
        "research_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "context_figure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lever_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "published_conversions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "eur_bn",
              "metric",
              "value"
            ],
            "properties": {
              "eur_bn": {
                "type": "number"
              },
              "metric": {
                "enum": [
                  "days_of_spending",
                  "pct_of_deficit",
                  "eur_per_inhabitant"
                ]
              },
              "value": {
                "type": "number"
              },
              "from": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(claimed|range|claimed_\\d{4})$": {
              "$ref": "#/$defs/derived_set"
            }
          }
        },
        "claimed_path": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "year",
              "central"
            ],
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              "central": {
                "type": "number"
              },
              "text_en": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "proposer": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "orientation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z_0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "party",
            "coalition",
            "government",
            "think_tank"
          ]
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
