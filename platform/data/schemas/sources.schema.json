{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/sources.schema.json",
  "title": "Source registry",
  "type": "object",
  "required": [
    "meta",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "dataset",
        "schema",
        "as_of",
        "version",
        "description",
        "conventions"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "conventions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "type",
        "research_file",
        "institution",
        "title",
        "date",
        "urls"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f\\d{2}(:[A-Za-z0-9_^-]+)?$"
        },
        "type": {
          "enum": [
            "research_file",
            "canonical_row",
            "publication",
            "footnote"
          ]
        },
        "research_file": {
          "type": "string"
        },
        "institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
